---
const label = "mb-2 block text-[11px] font-semibold uppercase tracking-wide text-[#3b4548]/80";
const field =
  "w-full border border-[#e4e4e4] bg-[#f7f7f7] px-3.5 py-3 text-[15px] text-[#3b4548] placeholder:text-[#3b4548]/60 outline-none focus:border-[#143338] focus:bg-white";
const select = field + " appearance-none pr-10";
const area = field + " h-[66px] resize-none";

const projectTypes = ["New build", "Renovation", "Interior design", "Landscape", "Other"];
const areas = ["Kitchen", "Living spaces", "Bedrooms", "Bathrooms", "Outdoor", "Whole property"];
---

<div class="flex min-h-screen items-center justify-center bg-[#fdebd8] p-4 lg:p-8">
  <div class="grid w-full max-w-265 overflow-hidden bg-white lg:min-h-150 lg:grid-cols-2">

    <!-- Left panel -->
    <section class="relative bg-[#143338] px-8 pb-48 pt-12 text-[#c9d3d2] lg:pb-0">
      <h1 class="text-5xl leading-tight text-white">Join the waitlist</h1>
      <p class="mt-6 max-w-120 text-[19px] leading-[1.45]">
        If you have a grand vision for your space and are looking for uncompromising quality,
        please take a few moments to share the scope of your project below.
      </p>
      <p class="mt-6 max-w-120 text-[19px] leading-[1.45]">
        Our team reviews every detail to ensure alignment before initiating our consultation phase.
      </p>

      <svg class="pointer-events-none absolute bottom-0 left-0 w-full" viewBox="0 0 526 300" preserveAspectRatio="xMinYMax meet" aria-hidden="true">
        <polygon points="0,62 165,15 0,110" fill="#a5503e" />
        <polygon points="0,110 177,7 88,142 0,172" fill="#ec8c1c" />
        <polygon points="0,172 88,142 0,275" fill="#4d5b3a" />
        <polygon points="80,300 160,265 130,300" fill="#4d5b3a" />
        <polygon points="130,300 292,199 220,300" fill="#ec8c1c" />
      </svg>
    </section>

    <!-- Right panel -->
    <section class="px-6 py-10 lg:px-9">
      <form action="/api/waitlist" method="post" class="flex flex-col gap-7">

        <div class="grid gap-7 sm:grid-cols-2">
          <div>
            <label class={label} for="first_name">First name</label>
            <input class={field} id="first_name" name="first_name" type="text" placeholder="Jane" required />
          </div>
          <div>
            <label class={label} for="last_name">Last name</label>
            <input class={field} id="last_name" name="last_name" type="text" placeholder="Smith" required />
          </div>
        </div>

        <div class="grid gap-7 sm:grid-cols-2">
          <div>
            <label class={label} for="phone">Phone number</label>
            <input class={field} id="phone" name="phone" type="tel" placeholder="+123456789" />
          </div>
          <div>
            <label class={label} for="email">Email address</label>
            <input class={field} id="email" name="email" type="email" placeholder="jane_smith@acme.com" required />
          </div>
        </div>

        <div>
          <label class={label} for="address">Project address (if different from home address)</label>
          <textarea class={area} id="address" name="address" placeholder="Address"></textarea>
        </div>

        <div class="grid gap-7 sm:grid-cols-2">
          <div>
            <label class={label} for="project_type">Project type</label>
            <div class="relative">
              <select class={select} id="project_type" name="project_type" required>
                <option value="" disabled selected>Select your type</option>
                {projectTypes.map((t) => <option value={t}>{t}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2" width="12" height="8" viewBox="0 0 12 8"><path d="M0 0h12L6 8z" fill="#79908f" /></svg>
            </div>
          </div>
          <div>
            <label class={label} for="areas">Areas of the property involved</label>
            <div class="relative">
              <select class={select} id="areas" name="areas" required>
                <option value="" disabled selected>Select areas</option>
                {areas.map((a) => <option value={a}>{a}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2" width="12" height="8" viewBox="0 0 12 8"><path d="M0 0h12L6 8z" fill="#79908f" /></svg>
            </div>
          </div>
        </div>

        <div>
          <label class={label} for="goals">Briefly describe your project goals</label>
          <textarea class={area} id="goals" name="goals" placeholder="Your aims and goals"></textarea>
        </div>

        <button type="submit" class="mt-2 inline-flex h-9.75 w-full items-center justify-center gap-2 bg-[#143338] text-sm font-semibold text-white hover:bg-[#143338]/90">
          Next
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="8" fill="white" />
            <path d="M4.5 8h6M8 5l3 3-3 3" stroke="#143338" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </form>
    </section>
  </div>
</div>