---
interface Props {
    image: string
    description:string
}
const {image,description} = Astro.props
---
<div class="who-are-we_card">
    <div class="who-are-we_card-img-wrap">
    <img class="who-are-we_card-img" src={image} alt={description}/>  
    </div>
     <p >{description}</p>            
    </div>

<style>
  
.who-are-we_card {
    color: #f5f3e8;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.who-are-we_card-img-wrap {
    width: 100%;
    aspect-ratio: 3 / 5;
    overflow: hidden;
}

.who-are-we_card-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.who-are-we_card-img-wrap:hover .who-are-we_card-img {
    transform: scale(1.04);
}

.who-are-we_card p {
    margin: 0;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 2px;
    line-height: 1.6;
    text-transform: uppercase;
    color: #f5f3e8;
}
</style>